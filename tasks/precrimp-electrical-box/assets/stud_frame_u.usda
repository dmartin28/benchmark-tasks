def Xform "Frame" {
def Material "Steel" {
      token outputs:surface.connect = </Frame/Steel/shader.outputs:surface>
      def Shader "shader" {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.3, 0.33, 0.36)
        float inputs:metallic = 0.65
        float inputs:roughness = 0.4
        token outputs:surface
      }
    }
def Material "Mark" {
      token outputs:surface.connect = </Frame/Mark/shader.outputs:surface>
      def Shader "shader" {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.02, 0.15, 0.48)
        float inputs:metallic = 0
        float inputs:roughness = 0.4
        token outputs:surface
      }
    }

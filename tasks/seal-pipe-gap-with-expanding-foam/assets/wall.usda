#usda 1.0
(
    defaultPrim = "wall"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "wall" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
)
{
    def "Looks"
    {
        def Material "spruce"
        {
            token outputs:surface.connect = </wall/Looks/spruce/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.82, 0.68, 0.48)
                float inputs:metallic = 0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        def Material "drywall"
        {
            token outputs:surface.connect = </wall/Looks/drywall/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.78)
                float inputs:metallic = 0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        def Material "copper"
        {
            token outputs:surface.connect = </wall/Looks/copper/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.45, 0.25)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

